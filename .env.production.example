# VPS production environment template
NODE_ENV=production
PORT=3001
CLIENT_ORIGIN=https://community.example.com
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://school_app:replace-with-postgres-password@postgres:5432/school_community
REDIS_URL=redis://redis:6379
REDIS_SESSION_STORE=true
R2_UPLOAD_ENABLED=true
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET_NAME=school-community-images
R2_PUBLIC_URL=https://images.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password
