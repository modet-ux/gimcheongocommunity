# 학교 커뮤니티 서버 환경변수
# 데이터베이스
DATABASE_URL=postgresql://user:password@localhost:5432/school_community

# 세션 비밀키 (랜덤 문자열, 최소 32자)
SESSION_SECRET=your-session-secret-change-in-production

# Redis (로컬 개발시 없어도 됨, 없으면 인메모리 세션 사용)
REDIS_URL=redis://localhost:6379
# Redis 세션 사용 여부 (true일 때만 REDIS_URL 사용)
REDIS_SESSION_STORE=false

# Cloudflare R2
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=school-community-images

# 서버 포트
PORT=3001

# CORS 허용 오리진 (단일 도메인 배포 시 같은 공개 도메인)
CLIENT_ORIGIN=http://localhost:5173

# 프로덕션에서 별도 클라이언트 디렉터리를 사용할 때만 지정
# CLIENT_DIST_DIR=/app/client/dist

# 관리자 초기 비밀번호 (개발 전용. production에서는 초기화 로직이 실행되지 않음)
ADMIN_INITIAL_PASSWORD=admin123

# R2 업로드 활성화 여부
R2_UPLOAD_ENABLED=false
# R2_PUBLIC_URL=https://images.example.com
